<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ysu.ldr.mapper.ManagerMapper">
    <select id="selectManagerInfo" resultType="Manager">
        select * from manager_info where manager_name = #{managerName}
    </select>
    <select id="getManagerIdByName" resultType="Integer">
        select manager_id from manager_info where manager_name = #{managerName}
    </select>
</mapper>