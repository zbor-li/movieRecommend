<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ysu.ldr.mapper.CarouselMapper">
    <insert id="addCarousel">
        insert into movie_carousel (movie_id, manager_id) values (#{movieId}, #{managerId})
    </insert>

    <select id="getCountAll" resultType="Integer">
        select count(*) from movie_carousel
    </select>

    <select id="findCarouselByMovieId" resultType="Integer">
        select count(*) from movie_carousel where movie_id = #{movieId}
    </select>

    <select id="getAllMovieId" resultType="Carousel">
        select movie_id from movie_carousel
    </select>

    <delete id="deleteCarouselMovie">
        delete from movie_carousel where movie_id = #{movieId}
    </delete>


</mapper>